# --- Python & Backend ---
venv/
.venv/
env/
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# Python Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/

# --- Node.js & Frontend (React / Vite) ---
node_modules/
apps/desktop/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite Build Outputs
apps/desktop/dist/
apps/desktop/dist-ssr/
*.local

# --- Desktop Container (Tauri & Rust) ---
apps/desktop/src-tauri/target/
**/src-tauri/target/
.tauri/

# --- Sandbox Temporary Runtime Directories ---
ailearn_sandbox_*/
**/ailearn_sandbox_*

# --- Logs & Databases ---
*.log
logs/
*.sqlite
*.sqlite3
*.db
dump/

# --- IDEs & Editors ---
.vscode/
